#!/bin/bash

# system preferences
export TERM="xterm-256color"
export LANG=en_US.UTF-8

# Prefered programs
export EDITOR='vim'

if type bat > /dev/null; then
    export MANPAGER='bat -plman'
    export PAGER='bat'
fi


# Change Path
export PATH="${PATH}:$HOME/.local/bin"
export PATH="${PATH}:$HOME/bin"
export PATH="${PATH}:$HOME/.cargo/bin"
