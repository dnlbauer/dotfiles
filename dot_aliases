# colorize output
alias ls='ls --color=auto'
alias l='ls --color=auto -lFh'
alias ll='ls -lah --color=auto'

if type nvim > /dev/null; then
    alias vim=nvim
fi

if type bat > /dev/null; then
    alias cat='bat -pp'
fi

alias now='date +"%y%m%d%H%M%S"'

# file type aliases
alias -s txt=vim
alias -s md=vim
alias -s json=vim
alias -s yaml=vim
alias -s yml=vim
alias -s ini=vim
alias -s conf=vim
alias -s cfg=vim

# copy/paste for shell
alias pbcopy='xsel --clipboard --input'
alias pc=pbcopy
alias pbpaste='xsel --clipboard --output'
alias pp=pbpaste
alias clip='xsel --clipboard'

# keepass
alias kp=keepassxc-cli

## annoying defaults
claude() {
  if [[ ${1-} == resume ]]; then
    command claude --resume "${@:2}"
  else
    command claude "$@"
  fi
}
codex() {
  if [[ ${1-} == --resume ]]; then
    command codex resume "${@:2}"
  else
    command codex "$@"
  fi
}
copilot() {
  if [[ ${1-} == resume ]]; then
    command claude --resume "${@:2}"
  else
    command claude "$@"
  fi
}
